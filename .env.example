# Copy to .env (local dev only — never commit). In GitHub Actions these come
# from repo Secrets, not from this file.

# --- Instagram Graph API ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Meta app (only needed for token refresh workflow) ---
META_APP_ID=
META_APP_SECRET=

# --- Azure Speech (optional — only if spec/reel.json sets voice.provider=azure) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- Local upload testing (only if running `npm run publish` locally) ---
GITHUB_REPOSITORY=Yabes-Admin/ig-reels-publisher
GITHUB_TOKEN=
